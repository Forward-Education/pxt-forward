{
    "$comment": "RFC 7386 merge patch over upstream pxtarget.json: null deletes a key, objects merge, arrays replace. ${brand.*} comes from forward/brand.json. Plan M1 lists why each key is set. Header: the Forward logo in the organization slot, then the header name as text (useTextLogo) in Poppins, on the forward-light theme. The micro:bit logo is removed.",
    "name": "${brand.domain}",
    "title": "${brand.productName}",
    "description": "${brand.description}",
    "cloud": {
        "apiRoot": "/api/",
        "sharing": false,
        "publishing": false,
        "importing": false,
        "thumbnails": false,
        "preferredPackages": [],
        "cloudProviders": null
    },
    "simulator": {
        "messageSimulators": {
            "robot": null
        }
    },
    "appTheme": {
        "organization": "${brand.organization}",
        "organizationUrl": "${brand.organizationUrl}",
        "organizationLogo": "${brand.headerLogo}",
        "organizationWideLogo": "${brand.headerLogo}",
        "homeUrl": "${brand.homeUrl}",
        "embedUrl": "${brand.homeUrl}",
        "shareUrl": null,
        "privacyUrl": "${brand.privacyUrl}",
        "termsOfUseUrl": "${brand.termsOfUseUrl}",
        "logoUrl": "${brand.organizationUrl}",
        "githubUrl": "${brand.githubUrl}",
        "docMenu": [
            {
                "name": "Support",
                "path": "${brand.supportUrl}"
            },
            {
                "name": "Reference",
                "path": "/reference"
            },
            {
                "name": "Hardware",
                "path": "/device"
            },
            {
                "name": "Forward Education",
                "path": "${brand.organizationUrl}"
            }
        ],
        "crowdinProject": null,
        "socialOptions": null,
        "homeScreenHero": null,
        "homeScreenHeroGallery": null,
        "disableLiveTranslations": true,
        "githubEditor": false,
        "enabledFeatures": {
            "aiErrorHelp": null
        },
        "immersiveReader": false,
        "supportedExperiences": [],
        "qrCode": false,
        "shareHomepageContent": false,
        "useTextLogo": true,
        "organizationText": "${brand.headerName}",
        "organizationShortText": "${brand.headerName}",
        "logo": null,
        "portraitLogo": null,
        "defaultColorTheme": "forward-light"
    }
}
