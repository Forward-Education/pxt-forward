        },
        "forward-education/pxt-climate-action": {
            "name": "fwd-climate-action",
            "spec": "github:Forward-Education/pxt-climate-action#v2.0.3"
        },
        "forward-education/pxt-smart-hydroponics": {
            "name": "fwd-smart-hydroponics",
            "spec": "github:Forward-Education/pxt-smart-hydroponics#v1.2.3"
        },
        "forward-education/pxt-smart-soldering": {
            "name": "fwd-smart-soldering",
            "spec": "github:Forward-Education/pxt-smart-soldering#v1.2.3"
        },
        "forward-education/pxt-smart-solar": {
            "name": "fwd-smart-solar",
            "spec": "github:Forward-Education/pxt-smart-solar#v2.0.3"
        },
        "forward-education/pxt-robot-tour": {
            "name": "fwd-robot-tour",
            "spec": "github:Forward-Education/pxt-robot-tour#v1.0.4"
        },
        "climate-action-kits/pxt-fwd-edu": {
            "replace": "forward-education/pxt-climate-action"
        },
        "forward-education/pxt-fwd-all": {
            "replace": "forward-education/pxt-all-fwd-blocks"
        },
        "microsoft/pxt-jacdac": {
            "drop": true
        },
        "jacdac/pxt-jacdac": {
            "drop": true
        }
